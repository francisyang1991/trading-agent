# WhatsApp Business API Configuration
# Copy this file to whatsapp-business.env and fill in your values
# DO NOT commit the actual .env file to version control

# Your WhatsApp Business phone number ID (from Meta Business Portal)
WA_PHONE_NUMBER_ID=your_phone_number_id

# WhatsApp Cloud API access token (from Meta Business Portal)
CLOUD_API_ACCESS_TOKEN=your_access_token

# Cloud API version (check Meta docs for latest)
CLOUD_API_VERSION=v18.0

# Webhook configuration
WEBHOOK_ENDPOINT=/webhook/whatsapp
WEBHOOK_VERIFICATION_TOKEN=your_verification_token

# Optional: Webhook port (default 3000)
WHATSAPP_WEBHOOK_PORT=3000
