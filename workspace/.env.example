# =============================================================================
# Discord Bot Environment Variables
# =============================================================================
# Copy this to .env and fill in your actual tokens.
# On Mac Mini: scripts/setup_mac_mini.sh reads this file automatically.

# --- Required ---

# Discord Bot Token (interactive bot)
# Get from: https://discord.com/developers/applications
DISCORD_BOT_TOKEN=your_discord_bot_token_here

# Discord User Token (for scraping messages from signal servers)
DISCORD_USER_TOKEN=your_discord_user_token_here

# MiniMax API Key (LLM analysis fallback)
MINIMAX_API_KEY=your_minimax_api_key_here

# --- Optional: Claude Agent ---

# Separate bot token for the Claude agent (@claudecode)
# If not set, claude agent won't start
DISCORD_BOT_TOKEN_CLAUDE=

# Anthropic API key (enables Claude-based analysis in both bots)
ANTHROPIC_API_KEY=

# --- Optional: Trade Execution API ---

# GCloud Trading API (for !approve, position tracking)
TRADE_API_URL=http://34.75.9.166:8080
TRADE_API_KEY=saiyan-trade-2026

# --- Optional: Citrini Email Pipeline ---

# Set to "true" to enable periodic Citrini email checks
CITRINI_EMAIL_ENABLED=false
CITRINI_EMAIL_INTERVAL_MIN=60

# --- Optional: Exa Search ---

EXA_API_KEY=

# --- Optional: Scheduling ---

# Timezone for scheduled tasks (default: America/Los_Angeles)
SCHEDULER_TZ=America/Los_Angeles

# Pipeline timeout in seconds (default: 1200)
PIPELINE_TIMEOUT_SECONDS=1200

# --- Optional: Daily Signals Email ---

# SMTP config for daily signals email (francis.yang1991@gmail.com)
# Required for --send-email in daily_signals.py cron
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USERNAME=your-email@gmail.com
# SMTP_PASSWORD=your-app-password
# EMAIL_SENDER=your-email@gmail.com

# --- Optional: Health Monitoring ---

# Discord webhook URL for health alerts (leave empty to disable)
WATCHDOG_DISCORD_WEBHOOK=

# Channel ID for digest/proactive messages
DIGEST_CHANNEL_ID=1345123472019423284
PROACTIVE_CHANNEL_ID=1345123472019423284
