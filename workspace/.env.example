# Discord Signal Analysis - Environment Variables
# Copy this to .env and fill in your actual tokens

# Discord Bot Token (for sending messages to Rich or Die channel)
# Get from: https://discord.com/developers/applications
DISCORD_BOT_TOKEN=your_discord_bot_token_here

# Discord User Token (for scraping messages from Goku/Wilson servers)
# This is your personal Discord user token (NOT the bot token)
DISCORD_USER_TOKEN=your_discord_user_token_here

# MiniMax API Key (for LLM analysis)
MINIMAX_API_KEY=your_minimax_api_key_here
