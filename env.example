# SAIYAN Trading Agent - Environment Variables
# Copy this file to env.list and fill in your IBKR credentials
# WARNING: Keep env.list secure and never commit it to git!

# =============================================================================
# IB Gateway (ib_async native API) - RECOMMENDED
# =============================================================================
# Used by: docker compose --profile gateway up -d

# IBKR Account Credentials
IB_USERNAME=your_ibkr_username
IB_PASSWORD=your_ibkr_password
IB_TRADING_MODE=paper              # paper or live

# Connection Settings (for local development)
IB_HOST=127.0.0.1
IB_PORT=4002                       # 4001=live, 4002=paper
IB_CLIENT_ID=1
IB_READONLY=no                     # yes or no

# Data routing
# prod     = prefer GCP IBKR-backed APIs for live reads
# dev      = prefer local sources and caches for debugging
# backtest = prefer local historical stores for research
SAIYAN_DATA_MODE=dev
IBKR_GCLOUD_URL=
IBKR_GCLOUD_API_KEY=
SAIYAN_DATA_ARCHIVE_URI=

# Connection Reliability
IB_RECONNECT_DELAY=5               # Initial reconnect delay in seconds
IB_MAX_RECONNECT_ATTEMPTS=10       # Max reconnection attempts
IB_HEARTBEAT_INTERVAL=30           # Heartbeat interval in seconds
IB_CONNECTION_TIMEOUT=30           # Connection timeout in seconds

# Trading GUI
GUI_PORT=8080                      # Web dashboard port

# Optional: VNC for debugging (IB Gateway)
# VNC_PASSWORD=your_vnc_password

# =============================================================================
# IBeam (REST Web API) - Legacy
# =============================================================================
# Used by: docker compose --profile ibeam up -d

IBEAM_ACCOUNT=your_ibkr_username
IBEAM_PASSWORD=your_ibkr_password

# Optional: Two-Factor Authentication
# IBEAM_2FA_HANDLER=your_2fa_handler

# Optional: Gateway Configuration
# IBEAM_GATEWAY_BASE_URL=https://localhost:5000
# IBEAM_REQUEST_TIMEOUT=30
# IBEAM_PAGE_LOAD_TIMEOUT=60

# Optional: Advanced Settings
# IBEAM_LOG_LEVEL=INFO
# IBEAM_STRICT_SSL_TEST=false

# =============================================================================
# Email Notifications (Daily Scanner Report)
# =============================================================================
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USERNAME=your_email@gmail.com
# SMTP_PASSWORD=your_app_password
# SMTP_USE_TLS=true
#
# EMAIL_SENDER=your_email@gmail.com
# EMAIL_RECIPIENTS=your_email@gmail.com
# EMAIL_SUBJECT_PREFIX=[SAIYAN]
