# SAIYAN Trading Agent - LIVE (Production) Environment
# Copy to env.live.list and fill in your LIVE IBKR credentials
# WARNING: Never commit env.live.list to git!

# =============================================================================
# LIVE IBKR Account - Real money trading
# =============================================================================

IB_USERNAME=your_live_ibkr_username
IB_PASSWORD=your_live_ibkr_password
IB_TRADING_MODE=live
IB_READONLY=no

# Connection - Live uses port 4001 (4004 socat for Docker if TrustedIPs blocks)
IB_HOST=ib-gateway
IB_PORT=4001
IB_CLIENT_ID=1
TWS_ACCEPT_INCOMING=all

# GUI
GUI_PORT=8080

# VNC (optional, for debugging)
VNC_PASSWORD=changeme
