<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.saiyan.interactive-bot</string>

    <key>ProgramArguments</key>
    <array>
        <string>__REPO_DIR__/venv/bin/python</string>
        <string>-u</string>
        <string>interactive_bot.py</string>
    </array>

    <key>WorkingDirectory</key>
    <string>__REPO_DIR__/workspace/scripts/discord_bot</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
        <key>PYTHONUNBUFFERED</key>
        <string>1</string>
    </dict>

    <key>StandardOutPath</key>
    <string>__REPO_DIR__/logs/interactive-bot-stdout.log</string>

    <key>StandardErrorPath</key>
    <string>__REPO_DIR__/logs/interactive-bot-stderr.log</string>

    <key>KeepAlive</key>
    <dict>
        <key>SuccessfulExit</key>
        <false/>
    </dict>

    <key>ThrottleInterval</key>
    <integer>15</integer>

    <key>RunAtLoad</key>
    <true/>

    <key>Nice</key>
    <integer>5</integer>
</dict>
</plist>
